# Copy to .env and fill in your own values. .env is not tracked by git.

# Google Cloud project that owns the Artifact Registry repository.
GOOGLE_CLOUD_PROJECT=your-project-id

# Region of the repository, for example europe-west6. The registry endpoint is
# regional, so this is a region and not a zone such as europe-west6-a.
GOOGLE_CLOUD_REGION=europe-west6

# Name of the Artifact Registry repository of type Docker.
ARTIFACT_REGISTRY_REPOSITORY=your-repository-name

# Service account the Cloud Run service runs as. It needs no roles, because the
# server calls no Google API. Create it before the first deploy with
# gcloud iam service-accounts create <name> --project <project-id>.
CLOUD_RUN_SERVICE_ACCOUNT=coesa-runtime
